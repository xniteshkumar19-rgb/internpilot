{
  "version": 2,
  "functions": {
    "api/index.js": {
      "includeFiles": "internpilot/test-postings.json,internpilot/sample-resume.txt",
      "maxDuration": 15
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/(.*)",
      "destination": "/internpilot/public/$1"
    }
  ]
}
